generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                    @id @default(cuid())
  clerkUserId              String                    @unique
  email                    String
  fullName                 String
  loyaltyCardNumber        String                    @unique
  loyaltyPoints            Int                       @default(0)
  loyaltyTier              LoyaltyTier               @default(bronze)
  installmentsEligible     Boolean                   @default(false)
  stripeCustomerId         String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  activitySegment          CustomerActivitySegment   @default(NO_PURCHASE)
  loyaltySuspendedAt       DateTime?
  loyaltySuspensionReason  String?
  anonymizationRequestedAt DateTime?
  anonymizedAt             DateTime?
  loyaltyTierQualifiedAt   DateTime?
  loyaltyTierValidUntil    DateTime?
  addresses                Address[]
  consents                 CustomerConsent[]
  exportLogs               CustomerExportLog[]
  notes                    CustomerNote[]
  privacyRequests          CustomerPrivacyRequest[]
  qualityIssues            CustomerQualityIssue[]
  customerTags             CustomerTagAssignment[]
  rewardRedemptions        LoyaltyRewardRedemption[]
  loyaltyTransactions      LoyaltyTransaction[]
  orders                   Order[]

  @@index([email])
  @@index([fullName])
  @@index([loyaltyTier])
  @@index([loyaltyTierValidUntil])
  @@index([activitySegment])
  @@index([createdAt])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  name      String
  address   String
  city      String
  phone     String
  state     String
  zip       String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isDefault])
}

model Category {
  id          String            @id @default(cuid())
  title       String
  slug        String            @unique
  description String?
  range       Int?
  featured    Boolean           @default(false)
  imageUrl    String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  parentId    String?
  isActive    Boolean           @default(true)
  archivedAt  DateTime?
  archivedBy  String?
  parent      Category?         @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[]        @relation("CategoryTree")
  products    ProductCategory[]

  @@index([title])
  @@index([parentId, range, title])
  @@index([isActive, archivedAt])
  @@index([featured, isActive, archivedAt])
  @@index([archivedAt])
  @@index([title(ops: raw("gin_trgm_ops"))], map: "Category_title_trgm_idx", type: Gin)
}

model Brand {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String?
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isActive    Boolean   @default(true)
  archivedAt  DateTime?
  archivedBy  String?
  products    Product[]

  @@index([title])
  @@index([isActive, archivedAt])
  @@index([archivedAt])
  @@index([title(ops: raw("gin_trgm_ops"))], map: "Brand_title_trgm_idx", type: Gin)
}

model Product {
  id                          String                       @id @default(cuid())
  name                        String
  slug                        String                       @unique
  description                 String?
  price                       Decimal                      @db.Decimal(10, 2)
  discount                    Int                          @default(0)
  stock                       Int                          @default(0)
  status                      ProductStatus                @default(new)
  isFeatured                  Boolean                      @default(false)
  brandId                     String?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  sku                         String                       @unique
  barcode                     String?                      @unique
  shortDescription            String?
  fullDescription             String?
  regularPrice                Decimal                      @db.Decimal(10, 2)
  salePrice                   Decimal?                     @db.Decimal(10, 2)
  isActive                    Boolean                      @default(true)
  isBestSeller                Boolean                      @default(false)
  isNewArrival                Boolean                      @default(false)
  isPromotion                 Boolean                      @default(false)
  seoTitle                    String?
  seoDescription              String?
  seoKeywords                 String?
  lastRestockedAt             DateTime?
  lifecycleStatus             ProductLifecycleStatus       @default(DRAFT)
  promotionStartsAt           DateTime?
  promotionEndsAt             DateTime?
  archivedAt                  DateTime?
  archivedBy                  String?
  homepageProductSectionItems HomepageProductSectionItem[]
  homepageSections            HomepageSectionProduct[]
  inventoryMovements          InventoryMovement[]
  orderItems                  OrderItem[]
  brand                       Brand?                       @relation(fields: [brandId], references: [id])
  categories                  ProductCategory[]
  images                      ProductImage[]
  relatedProducts             ProductRelated[]             @relation("ProductRelatedProducts")
  relatedToProducts           ProductRelated[]             @relation("ProductRelatedToProducts")
  tags                        ProductTag[]
  variants                    ProductVariant[]

  @@index([name])
  @@index([sku])
  @@index([brandId])
  @@index([status])
  @@index([price])
  @@index([isActive, isFeatured, isBestSeller, isNewArrival, isPromotion])
  @@index([lifecycleStatus, updatedAt])
  @@index([archivedAt])
  @@index([isPromotion, promotionStartsAt, promotionEndsAt])
  @@index([barcode(ops: raw("gin_trgm_ops"))], map: "Product_barcode_trgm_idx", type: Gin)
  @@index([name(ops: raw("gin_trgm_ops"))], map: "Product_name_trgm_idx", type: Gin)
  @@index([sku(ops: raw("gin_trgm_ops"))], map: "Product_sku_trgm_idx", type: Gin)
}

model ProductImage {
  id        String          @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  variantId String?
  isPrimary Boolean         @default(false)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([productId, sortOrder])
  @@index([variantId, sortOrder])
}

model ProductVariant {
  id           String         @id @default(cuid())
  productId    String
  title        String
  sku          String         @unique
  barcode      String?        @unique
  option1Name  String?
  option1Value String?
  option2Name  String?
  option2Value String?
  option3Name  String?
  option3Value String?
  regularPrice Decimal        @db.Decimal(10, 2)
  salePrice    Decimal?       @db.Decimal(10, 2)
  stock        Int            @default(0)
  isActive     Boolean        @default(true)
  sortOrder    Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  images       ProductImage[]
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@index([isActive, stock])
}

model ProductRelated {
  productId        String
  relatedProductId String
  createdAt        DateTime @default(now())
  product          Product  @relation("ProductRelatedProducts", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct   Product  @relation("ProductRelatedToProducts", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@id([productId, relatedProductId])
  @@index([relatedProductId])
}

model ProductCategory {
  productId  String
  categoryId String
  assignedAt DateTime @default(now())
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model Tag {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  products    ProductTag[]

  @@index([title])
}

model ProductTag {
  productId  String
  tagId      String
  assignedAt DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

model PromoCode {
  id                    String            @id @default(cuid())
  title                 String
  code                  String            @unique
  active                Boolean           @default(true)
  discountType          PromoDiscountType @default(percentage)
  discountValue         Decimal           @db.Decimal(10, 2)
  minimumOrderAmount    Decimal           @default(0) @db.Decimal(10, 2)
  allowedPaymentMethods PaymentMethod[]
  startsAt              DateTime?
  endsAt                DateTime?
  usageLimit            Int?
  usedCount             Int               @default(0)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([active])
  @@index([startsAt, endsAt])
}

model Order {
  id                       String                 @id @default(cuid())
  orderNumber              String                 @unique
  userId                   String?
  clerkUserId              String?
  customerName             String
  email                    String
  currency                 String                 @default("MAD")
  status                   OrderStatus            @default(pending)
  paymentStatus            PaymentStatus          @default(pending)
  paymentMethod            PaymentMethod          @default(cmi_card)
  totalPrice               Decimal                @db.Decimal(10, 2)
  amountDiscount           Decimal                @default(0) @db.Decimal(10, 2)
  promoCode                String?
  promoDiscount            Decimal                @default(0) @db.Decimal(10, 2)
  orderDate                DateTime               @default(now())
  installmentMonths        Int?
  installmentMonthlyAmount Decimal?               @db.Decimal(10, 2)
  shippingName             String?
  shippingPhone            String?
  shippingAddress          String?
  shippingCity             String?
  shippingState            String?
  shippingZip              String?
  invoiceId                String?
  invoiceNumber            String?
  invoiceHostedUrl         String?
  stripeCheckoutSessionId  String?                @unique
  stripeCustomerId         String?
  stripePaymentIntentId    String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  deliveryCompany          String?
  deliveryPersonName       String?
  driverPhoneNumber        String?
  trackingNumber           String?
  deliveryStatus           DeliveryStatus         @default(not_assigned)
  statusChangedAt          DateTime               @default(now())
  fulfillmentStatus        FulfillmentStatus      @default(to_prepare)
  confirmationRequired     Boolean                @default(false)
  confirmedAt              DateTime?
  preparationStartedAt     DateTime?
  preparedAt               DateTime?
  shippedAt                DateTime?
  deliveredAt              DateTime?
  estimatedDeliveryAt      DateTime?
  version                  Int                    @default(0)
  qualityIssues            CustomerQualityIssue[]
  inventoryMovements       InventoryMovement[]
  loyaltyRefundEvents      LoyaltyRefundEvent[]
  loyaltyTransactions      LoyaltyTransaction[]
  user                     User?                  @relation(fields: [userId], references: [id])
  events                   OrderEvent[]
  items                    OrderItem[]
  notes                    OrderNote[]
  returns                  OrderReturn[]

  @@index([clerkUserId, orderDate])
  @@index([status, paymentStatus])
  @@index([fulfillmentStatus, orderDate])
  @@index([deliveryStatus, orderDate])
  @@index([statusChangedAt])
  @@index([email])
  @@index([customerName])
  @@index([shippingPhone])
  @@index([shippingCity])
  @@index([trackingNumber])
}

model InventoryMovement {
  id               String                  @id @default(cuid())
  productId        String
  previousQuantity Int
  quantityDelta    Int
  newQuantity      Int
  reason           InventoryMovementReason
  note             String?
  actorUserId      String?
  actorEmail       String?
  actorName        String?
  relatedOrderId   String?
  idempotencyKey   String?                 @unique
  createdAt        DateTime                @default(now())
  product          Product                 @relation(fields: [productId], references: [id])
  relatedOrder     Order?                  @relation(fields: [relatedOrderId], references: [id])

  @@index([productId, createdAt])
  @@index([relatedOrderId, createdAt])
  @@index([reason, createdAt])
}

model OrderEvent {
  id          String   @id @default(cuid())
  orderId     String
  type        String
  title       String
  description String?
  actorUserId String?
  actorEmail  String?
  actorName   String?
  metadata    Json?
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([type, createdAt])
}

model OrderNote {
  id          String   @id @default(cuid())
  orderId     String
  content     String
  createdBy   String
  actorUserId String?
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model OrderReturn {
  id           String       @id @default(cuid())
  orderId      String
  status       ReturnStatus @default(requested)
  reason       String
  itemSnapshot Json?
  refundStatus String?
  refundAmount Decimal?     @db.Decimal(10, 2)
  refundedAt   DateTime?
  requestedBy  String?
  reviewedBy   String?
  receivedAt   DateTime?
  inspectedAt  DateTime?
  closedAt     DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  order        Order        @relation(fields: [orderId], references: [id])

  @@index([orderId, status])
  @@index([status, createdAt])
}

model OrderSlaPolicy {
  id                String        @id @default(cuid())
  name              String
  stage             OrderSlaStage
  durationHours     Int
  workingDays       Boolean       @default(true)
  applicableCarrier String?
  applicableZone    String?
  priority          Int           @default(0)
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([stage, isActive, priority])
}

model LoyaltyProgramSettings {
  id                          String   @id @default("default")
  statusValidityMonths        Int      @default(12)
  pointExpirationMonths       Int      @default(18)
  expirationAlertDays         Int[]    @default([60, 30, 7])
  separateStatusAndPoints     Boolean  @default(true)
  newCustomerDays             Int      @default(30)
  activeCustomerDays          Int      @default(90)
  inactiveCustomerDays        Int      @default(365)
  loyalMinimumOrders          Int      @default(3)
  loyalMinimumRevenue         Decimal  @default(1000) @db.Decimal(10, 2)
  reengagementCycleMultiplier Decimal  @default(1.5) @db.Decimal(5, 2)
  minimumOrdersForCycle       Int      @default(3)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

model LoyaltyTierRule {
  id                  String      @id @default(cuid())
  tier                LoyaltyTier @unique
  pointsPer100Mad     Int
  revenueThreshold    Decimal     @db.Decimal(10, 2)
  qualificationMonths Int         @default(12)
  isActive            Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([isActive, revenueThreshold])
}

model LoyaltyTransaction {
  id                    String                   @id @default(cuid())
  userId                String
  orderId               String?
  rewardRedemptionId    String?
  type                  LoyaltyTransactionType
  amount                Int
  reason                String
  previousBalance       Int
  newBalance            Int
  expiresAt             DateTime?
  createdBy             String?
  idempotencyKey        String?                  @unique
  metadata              Json?
  reversedTransactionId String?
  createdAt             DateTime                 @default(now())
  refundEvent           LoyaltyRefundEvent?
  order                 Order?                   @relation(fields: [orderId], references: [id])
  reversedTransaction   LoyaltyTransaction?      @relation("LoyaltyReversals", fields: [reversedTransactionId], references: [id])
  reversals             LoyaltyTransaction[]     @relation("LoyaltyReversals")
  rewardRedemption      LoyaltyRewardRedemption? @relation(fields: [rewardRedemptionId], references: [id])
  user                  User                     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([orderId, type])
  @@index([expiresAt])
  @@index([rewardRedemptionId])
}

model LoyaltyRefundEvent {
  id                   String              @id @default(cuid())
  orderId              String
  externalEventId      String
  refundedAmount       Decimal             @db.Decimal(10, 2)
  loyaltyTransactionId String?             @unique
  metadata             Json?
  createdAt            DateTime            @default(now())
  loyaltyTransaction   LoyaltyTransaction? @relation(fields: [loyaltyTransactionId], references: [id])
  order                Order               @relation(fields: [orderId], references: [id])

  @@unique([orderId, externalEventId])
  @@index([orderId, createdAt])
}

model LoyaltyReward {
  id              String                    @id @default(cuid())
  name            String
  description     String?
  type            LoyaltyRewardType
  pointsCost      Int
  monetaryValue   Decimal?                  @db.Decimal(10, 2)
  percentageValue Int?
  isActive        Boolean                   @default(true)
  archivedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  redemptions     LoyaltyRewardRedemption[]

  @@index([isActive, pointsCost])
}

model LoyaltyRewardRedemption {
  id                 String                  @id @default(cuid())
  userId             String
  rewardId           String
  status             LoyaltyRedemptionStatus @default(issued)
  pointsCostSnapshot Int
  rewardSnapshot     Json
  idempotencyKey     String                  @unique
  issuedBy           String?
  appliedAt          DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  reward             LoyaltyReward           @relation(fields: [rewardId], references: [id])
  user               User                    @relation(fields: [userId], references: [id])
  transactions       LoyaltyTransaction[]

  @@index([userId, createdAt])
  @@index([rewardId, status])
}

model CustomerTag {
  id          String                  @id @default(cuid())
  name        String                  @unique
  color       String                  @default("blue")
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  assignments CustomerTagAssignment[]
}

model CustomerTagAssignment {
  userId     String
  tagId      String
  assignedBy String?
  assignedAt DateTime    @default(now())
  tag        CustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, tagId])
  @@index([tagId, assignedAt])
}

model CustomerNote {
  id        String   @id @default(cuid())
  userId    String
  content   String
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model CustomerQualityIssue {
  id                String               @id @default(cuid())
  issueKey          String               @unique
  userId            String?
  orderId           String?
  type              QualityIssueType
  severity          QualityIssueSeverity
  status            QualityIssueStatus   @default(open)
  description       String
  recommendedAction String
  metadata          Json?
  detectedAt        DateTime             @default(now())
  reviewedAt        DateTime?
  reviewedBy        String?
  resolvedAt        DateTime?
  order             Order?               @relation(fields: [orderId], references: [id])
  user              User?                @relation(fields: [userId], references: [id])

  @@index([status, severity, detectedAt])
  @@index([userId, status])
  @@index([orderId])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorEmail  String?
  action      String
  entity      String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([entity, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model CustomerExportLog {
  id         String   @id @default(cuid())
  userId     String?
  exportedBy String
  format     String   @default("csv")
  rowCount   Int
  filters    Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([exportedBy, createdAt])
  @@index([userId, createdAt])
}

model CustomerPrivacyRequest {
  id          String               @id @default(cuid())
  userId      String
  type        PrivacyRequestType
  status      PrivacyRequestStatus @default(requested)
  reason      String?
  requestedBy String
  reviewedBy  String?
  reviewedAt  DateTime?
  completedAt DateTime?
  metadata    Json?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  user        User                 @relation(fields: [userId], references: [id])

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model CustomerConsent {
  id        String   @id @default(cuid())
  userId    String
  type      String
  granted   Boolean
  source    String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
}

model OrderItem {
  id                      String   @id @default(cuid())
  orderId                 String
  productId               String?
  productNameSnapshot     String
  productPriceSnapshot    Decimal  @db.Decimal(10, 2)
  productImageUrlSnapshot String?
  quantity                Int
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  order                   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product                 Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model StorefrontSettings {
  id                         String   @id @default("default")
  announcementEnabled        Boolean  @default(true)
  announcementText           String   @default("Livraison gratuite partout au Maroc des 299 MAD d'achat.")
  announcementHref           String?
  heroAutoplayMs             Int      @default(5000)
  featuredCategoriesTitle    String   @default("Categories en vedette")
  featuredCategoriesSubtitle String   @default("Retrouvez les univers les plus demandes par nos clientes.")
  promotionsTitle            String   @default("Promotions du moment")
  promotionsSubtitle         String   @default("Des remises actives sur une selection de produits.")
  bestSellersTitle           String   @default("Meilleures ventes")
  bestSellersSubtitle        String   @default("Les produits les plus commandes cette semaine.")
  newArrivalsTitle           String   @default("Nouveautes")
  newArrivalsSubtitle        String   @default("Les derniers ajouts de notre catalogue.")
  brandsTitle                String   @default("Marques partenaires")
  brandsSubtitle             String   @default("Des marques dermo-cosmetiques reconnues.")
  trustTitle                 String   @default("Pourquoi commander chez Zayna")
  trustSubtitle              String   @default("Des engagements clairs pour une experience d'achat fluide.")
  loyaltyBadge               String   @default("Programme fidelite")
  loyaltyTitle               String   @default("Cumulez des avantages a chaque commande")
  loyaltyDescription         String   @default("Activez votre carte fidelite pour debloquer des offres reservees, des remises personnalisees et un suivi sur mesure.")
  loyaltyCtaLabel            String   @default("Demander ma carte")
  loyaltyCtaHref             String   @default("/#contact")
  loyaltyHighlightText       String   @default("Service client disponible 7j/7")
  loyaltyImageUrl            String?
  newsletterTitle            String   @default("Restez informee des nouveautes")
  newsletterDescription      String   @default("Recevez nos conseils beaute, offres et lancements en avant-premiere.")
  newsletterPlaceholder      String   @default("Votre adresse e-mail")
  newsletterButtonLabel      String   @default("S'abonner")
  newsletterSuccessMessage   String   @default("Merci, votre inscription a bien ete prise en compte.")
  newsletterErrorMessage     String   @default("Impossible de valider votre inscription pour le moment.")
  footerAboutTitle           String   @default("A propos de Zayna")
  footerAboutDescription     String   @default("Votre parapharmacie en ligne pour une routine beaute et bien-etre complete.")
  footerQuickLinksTitle      String   @default("Liens rapides")
  footerLegalLinksTitle      String   @default("Informations legales")
  footerCategoriesTitle      String   @default("Categories")
  footerContactPhone         String?
  footerContactEmail         String?
  footerContactHours         String?
  footerCopyrightText        String   @default("ZAYNA. Tous droits reserves.")
  featuredCategoriesLimit    Int      @default(8)
  promotionsLimit            Int      @default(10)
  bestSellersLimit           Int      @default(10)
  newArrivalsLimit           Int      @default(10)
  brandsLimit                Int      @default(12)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model HomepageSection {
  id         String                   @id @default(cuid())
  key        String                   @unique
  type       HomepageSectionType
  title      String
  subtitle   String?
  isActive   Boolean                  @default(true)
  order      Int                      @default(0)
  layout     String?
  theme      String?
  ctaLabel   String?
  ctaLink    String?
  limit      Int?
  config     Json?
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
  archivedAt DateTime?
  startsAt   DateTime?
  endsAt     DateTime?
  products   HomepageSectionProduct[]

  @@index([isActive, archivedAt, order])
  @@index([startsAt, endsAt])
  @@index([type])
}

model HomepageSectionProduct {
  sectionId String
  productId String
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  section   HomepageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([sectionId, productId])
  @@index([sectionId, sortOrder])
  @@index([productId])
}

model HomepageProductSection {
  id        String                       @id @default(cuid())
  title     String
  subtitle  String?
  slug      String                       @unique
  isActive  Boolean                      @default(true)
  order     Int                          @default(0)
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt
  items     HomepageProductSectionItem[]

  @@index([isActive, order])
}

model HomepageProductSectionItem {
  id        String                 @id @default(cuid())
  sectionId String
  productId String
  order     Int                    @default(0)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  product   Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  section   HomepageProductSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, productId])
  @@index([sectionId, order])
  @@index([productId])
}

model HomeHeroSlide {
  id         String    @id @default(cuid())
  badge      String?
  title      String
  subtitle   String?
  ctaLabel   String?
  ctaHref    String?
  imageUrl   String?
  altText    String?
  sortOrder  Int       @default(0)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  startsAt   DateTime?
  endsAt     DateTime?

  @@index([isActive, archivedAt, sortOrder])
  @@index([startsAt, endsAt])
}

model HomeTrustItem {
  id          String    @id @default(cuid())
  title       String
  description String
  icon        String
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  @@index([isActive, archivedAt, sortOrder])
}

model SiteLink {
  id           String        @id @default(cuid())
  group        SiteLinkGroup
  title        String
  href         String
  sortOrder    Int           @default(0)
  openInNewTab Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  isActive     Boolean       @default(true)
  archivedAt   DateTime?

  @@index([group, isActive, archivedAt, sortOrder])
}

model SiteSocialLink {
  id           String    @id @default(cuid())
  platform     String
  title        String
  href         String
  sortOrder    Int       @default(0)
  openInNewTab Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  isActive     Boolean   @default(true)
  archivedAt   DateTime?

  @@index([isActive, archivedAt, sortOrder])
}

/// Versioned Homepage workspace. The public storefront keeps reading the
/// normalized content tables; `draft` is applied to them only by an explicit,
/// atomic publish operation.
model HomepageWorkspace {
  id               String    @id @default("default")
  draft            Json
  published        Json
  draftVersion     Int       @default(1)
  publishedVersion Int       @default(1)
  draftUpdatedAt   DateTime  @default(now())
  draftUpdatedBy   String?
  publishedAt      DateTime?
  publishedBy      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model NewsletterSubscription {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, createdAt])
}

