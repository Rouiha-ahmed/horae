DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zayna"
# Optional for serverless production runtimes that support pooled Postgres connections.
DATABASE_URL_POOLED=""
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
ADMIN_EMAILS="admin@example.com"
ADMIN_USER_IDS=""

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_replace_me"
CLERK_SECRET_KEY="sk_test_replace_me"

STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# Optional: WhatsApp order confirmations via Twilio.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
TWILIO_WHATSAPP_ORDER_TEMPLATE_SID=""
TWILIO_WHATSAPP_DEFAULT_COUNTRY_CODE="+212"

# Optional: expose the CMI card flow only when these are configured.
NEXT_PUBLIC_ENABLE_CMI="false"
CMI_CLIENT_ID=""
CMI_STORE_KEY=""

# Base64-encoded 32-byte key for stable Server Action IDs across deploys/restarts.
# Example generation: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="replace_with_base64_32_byte_key"
